        {
          "name": "brands",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Парсим ответ от сервера\r",
                  "const response = pm.response.json();\r",
                  "\r",
                  "if (response && response.data) {\r",
                  "    // Прогоняем массив через фильтр\r",
                  "    const shortDescItems = response.data.filter(item => {\r",
                  "        // Учитываем структуру Strapi (поля могут лежать прямо в объекте или внутри attributes)\r",
                  "        const desc = item.description || (item.attributes && item.attributes.description);\r",
                  "\r",
                  "        // Если это null, undefined или пустая строка (\"\") — оставляем (длина 0 < 100)\r",
                  "        if (!desc) return true;\r",
                  "\r",
                  "        // Оставляем только те, где длина строки строго меньше 100 символов\r",
                  "        return desc.length < 10;\r",
                  "    });\r",
                  "\r",
                  "    // Очищаем консоль и выводим нужный результат\r",
                  "    console.clear();\r",
                  "    console.log(`Найдено записей с описанием < 100 символов: ${shortDescItems.length}`);\r",
                  "    console.log(shortDescItems);\r",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
