    {
      "name": "checks",
      "description": "Готовые точечные проверки данных.",
      "item": [
        {
          "name": "brands-short-descriptions",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "",
                  "if (Array.isArray(response?.data)) {",
                  "    const shortDescItems = response.data.filter(item => {",
                  "        const desc = item.description ?? item.attributes?.description ?? '';",
                  "        return String(desc).length < 100;",
                  "    });",
                  "",
                  "    console.clear();",
                  "    console.log(`Найдено брендов с описанием < 100 символов: ${shortDescItems.length}`);",
                  "    console.log(shortDescItems);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/brands?pagination[pageSize]=100&fields[0]=name&fields[1]=description&filters[active][$eq]=true"
          },
          "response": []
        },
        {
          "name": "product-categories-by-key",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?pagination[pageSize]=1&fields[0]=name&filters[key][$eq]={{productKey}}&populate[categories][fields][0]=name&populate[category][fields][0]=name"
          },
          "response": []
        },
        {
          "name": "missing-product-categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?pagination[page]=1&pagination[pageSize]=100&fields[0]=name&filters[active][$eq]=true&filters[categories][$null]=true"
          },
          "response": []
        },
        {
          "name": "product-key-by-barcode",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/attributes?pagination[pageSize]=1&populate[product][fields]=key&fields=name&filters[barcode][$eq]={{barcode}}"
          },
          "response": []
        },
        {
          "name": "new-labels",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/attributes?pagination[page]=1&pagination[pageSize]=100&fields[0]=label_new&filters[label_new][$eq]=true"
          },
          "response": []
        },
        {
