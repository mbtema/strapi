          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "",
                  "if (Array.isArray(response?.data)) {",
                  "    const shortDescItems = response.data.filter(item => {",
                  "        const desc = item.description ?? item.attributes?.description ?? '';",
                  "        return String(desc).length < 100;",
                  "    });",
                  "",
                  "    console.clear();",
                  "    console.log(`Найдено записей с описанием < 100 символов: ${shortDescItems.length}`);",
